# =============================================================================
# GamFix — environment settings
#
# This is the only environment file in the project. Copy it and fill in the
# values marked CHANGE ME:
#
#     cp backend/.env.example backend/.env
#
#   Docker (the VPS)     cd infra/docker && docker compose up -d --build
#                        The whole stack reads this one file.
#   Local development    php artisan serve    (Laravel reads it directly)
#
# The frontends need no environment file: they are static files, and they call
# /api on the address they are opened from (Vercel forwards /api to this
# server — see vercel.json).
#
# Values with spaces or a # go in single quotes: 'some value'. Avoid $ in
# values; Docker Compose would read it as a variable.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=GamFix
APP_ENV=production
APP_DEBUG=false
# CHANGE ME — Laravel needs one on first start. Generate with:
#   openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=
# Public address of this server (the API).
APP_URL=https://51-44-152-213.sslip.io
# The web app (sign-in page, citizen screens, staff console) as visitors
# reach it. Links in e-mails and Google sign-in point here. On Vercel the
# web app is served under /app.
APP_FRONTEND_URL=https://gamfix-salldevvv-4600.vercel.app/app
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Who may call the API ----------------------------------------------------
# Addresses the site is opened from, comma-separated. `*` stands for one part
# of the address, so this single line covers the production address and every
# preview deployment of the Vercel project — and nothing else.
CORS_ORIGINS=https://*-salldevvv-4600.vercel.app

# --- Database ----------------------------------------------------------------
# The Docker stack always uses its own MariaDB container (DB_HOST is set by
# Docker). For `php artisan serve` you can switch to SQLite:
#   DB_CONNECTION=sqlite      (then the lines below are not used)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamfix
DB_USERNAME=gamfix
# CHANGE ME — password of the app's database account.
DB_PASSWORD=
# CHANGE ME — root password of the database server (used on first start only).
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Google sign-in ----------------------------------------------------------
# Leave empty to hide the Google button. Register this redirect URI in
# Google Cloud Console (APIs & Services -> Credentials):
#   https://51-44-152-213.sslip.io/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outgoing mail (verification + password reset links) ---------------------
# REQUIRED in production: the app cannot send verification or reset links
# without a real transport. Fill in your SMTP account (or use a provider
# like Resend with MAIL_MAILER=resend + RESEND_KEY).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=gamfix@pocketsoftware.dev
MAIL_FROM_NAME=GamFix
RESEND_KEY=

# --- GamFix ------------------------------------------------------------------
# Exact e-mail addresses that are platform administrators (comma-separated).
# CHANGE ME — set YOUR own address. The seeder only promotes an account that
# already registered with this exact e-mail; nothing is auto-created.
ADMIN_EMAILS=

# WhatsApp gateway (GOWA) — sends the phone verification codes.
# CHANGE ME — account the API uses with the gateway (any user name, any strong password).
GOWA_USER=gowa
GOWA_PASS=
# Device shown by GOWA after the QR scan, e.g. wa-2205111924. Empty = first linked device.
GOWA_DEVICE_ID=
# The WhatsApp gateway delivers ONLY the phone-verification codes
# (PhoneOtpService). There is no WhatsApp reporting channel: citizens
# report in the web app or the Telegram bot.
# One-time token for the first officer account: php artisan gamfix:bootstrap-staff --token=...
STAFF_BOOTSTRAP_TOKEN=

# --- Telegram citizen bot (docs/TELEGRAM-BOT.md) -----------------------------
# Token from @BotFather: /newbot -> name it -> copy the token here.
TELEGRAM_BOT_TOKEN=
# Bot username (without @) — the deep link for "Connect Telegram" in the settings page.
TELEGRAM_BOT_USERNAME=
# The webhook is guarded by Telegram's X-Telegram-Bot-Api-Secret-Token
# header (md5 of APP_KEY). After deploy register it:
#   docker compose exec api php artisan telegram:webhook

# --- Realtime (Laravel Reverb websockets) ------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=gamfix
# CHANGE ME — public key:   openssl rand -hex 16
REVERB_APP_KEY=
# CHANGE ME — private key:  openssl rand -hex 16
REVERB_APP_SECRET=
# Where browsers reach the websocket server. The web app reads these from
# /api/config, so nothing needs to be set on Vercel.
REVERB_PUBLIC_HOST=51-44-152-213.sslip.io
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
# Where this server delivers events to its own websocket server, and where
# that server listens. Docker sets all five for its containers; the values
# below are for `php artisan reverb:start` next to `php artisan serve`.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Docker stack ------------------------------------------------------------
# Ports the stack publishes on this server.
HTTP_PORT=80
TLS_PORT=443
# Port of the GOWA web page (QR scan) — localhost only. Open it through a
# tunnel:  ssh -L 3001:127.0.0.1:3001 user@server  ->  http://127.0.0.1:3001
GOWA_PORT=3001
# HTTPS: host name the free Let's Encrypt certificate is issued and renewed
# for. It must point at this server — <ip with dashes>.sslip.io always does.
# Leave empty to serve HTTP only.
TLS_HOST=51-44-152-213.sslip.io
# Optional: where Let's Encrypt sends expiry warnings.
TLS_EMAIL=
