# NOTE: target must NOT end in index.html — Pages normalizes those targets and
# the rule never fires (every /dash/* subpath then falls back to the landing
# SPA). app.html is a byte-identical copy of dash/index.html.
/dash/*           /dash/app 200
/login            /app/app 200
/signup           /app/app 200
/forgot-password  /app/app 200
/reset-password   /app/app 200
/onboarding       /app/app 200
/verify/email     /app/app 200
/verify/phone     /app/app 200
/report           /app/app 200
/my-reports       /app/app 200
/profile          /app/app 200
/institute        /app/app 200
/track            /app/app 200
/home             /app/app 200
/privacy          /landing 200
/terms            /landing 200

# deep-link safety net for stale dashboard bundles (they navigate to /app/*)
/app/login    /app/app 200
/app/home     /app/app 200
/app/signup   /app/app 200
/app/report   /app/app 200
/app/track    /app/app 200
