# Copy to .env and fill in before `docker compose up -d --build`.

# Port the web container (landing + citizen app + dashboard + API proxy)
# is published on. Use 80 if nothing else listens there, or e.g. 8080
# behind your own reverse proxy / Cloudflare.
WEB_PORT=80

# Port for the GOWA web UI (QR scan / device management).
GOWA_PORT=3001

# Basic auth shared between PocketBase hooks and the GOWA container.
# Both sides use the same credentials.
GOWA_USER=gowa
GOWA_PASS=CHANGE_ME_STRONG_PASSWORD

# WhatsApp device id used by the phone-otp hook (as shown by GOWA
# after linking, e.g. "wa-2205111924"). Leave empty to use the hook default.
GOWA_DEVICE_ID=
