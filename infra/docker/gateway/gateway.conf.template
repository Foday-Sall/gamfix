# GamFix gateway: the HTTP server. Rendered at container start by
# entrypoint.sh, which replaces @@FRONTEND_URL@@.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Docker's DNS. Upstreams are named through variables (see locations.conf),
    # so nginx starts even when the api or reverb container is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 20M;

    include /etc/nginx/gateway/locations.conf;
}
