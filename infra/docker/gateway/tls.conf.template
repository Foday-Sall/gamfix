# GamFix gateway: the HTTPS server. Rendered by entrypoint.sh only when a
# certificate exists (@@TLS_HOST@@ is replaced there).
server {
    listen 443 ssl;
    server_name @@TLS_HOST@@ _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    # Never disclose the nginx version (Server: nginx, not nginx/1.27.x).
    server_tokens off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 20M;

    include /etc/nginx/gateway/locations.conf;
}
